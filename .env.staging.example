# Copiar a .env.staging.local (ignorado por git) para compilar la app de staging.
# Solo valores PÚBLICOS: URL del proyecto y clave PUBLICABLE (limitada por RLS).
# Nunca una clave secreta (sb_secret_...) ni service_role.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo staging: acceso con correo y contraseña para usuarios de prueba.
VITE_TEST_PASSWORD_LOGIN=true
