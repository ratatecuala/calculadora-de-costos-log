{
  "name": "calculadora-de-fletes",
  "private": true,
  "version": "0.1.0",
  "description": "Calculadora de costos y cotizador de fletes (nombre comercial pendiente). Datos de ruta simulados hasta autorizar Google Routes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "campo": "vite-node scripts/campo/registro.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:staging": "tsc -p tsconfig.json --noEmit && vite build --mode staging && node scripts/embed-assets.mjs",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "dev:medicion": "vite --config vite.medicion.config.ts",
    "build:medicion": "tsc -p tsconfig.json --noEmit && vite build --config vite.medicion.config.ts",
    "build:medicion-privada": "VITE_FF_MEDICION=1 npm run build:medicion && node scripts/medicion-worker/empaquetar.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "4.156.2"
  }
}
